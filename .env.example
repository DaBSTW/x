# Copy to .env — every default below matches docker-compose.yml and works
# out of the box for local development. packages/config validates these with
# Zod at process boot (see apps/api/src/env.ts): a missing required variable
# kills the process immediately with a readable message, never on first request.

NODE_ENV=development

# ── API ──────────────────────────────────────────────────────────────────
API_PORT=3001
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Snowflake ID worker id (0-1023). Each API/worker instance needs a unique
# value in a multi-instance deployment; 0 is fine for a single local instance.
WORKER_ID=0

# ── ws-gateway (ROADMAP.md 2.2) ─────────────────────────────────────────
WS_GATEWAY_PORT=3002
# Heartbeat/backpressure defaults match SPECS.md §8.3 — only worth
# overriding in a test that needs a faster cadence than production.
# HEARTBEAT_INTERVAL_MS=30000
# HEARTBEAT_TIMEOUT_MS=60000
# BACKPRESSURE_LIMIT_BYTES=1048576

# ── Base de datos ────────────────────────────────────────────────────────
DATABASE_URL=postgres://x:x@localhost:5432/x

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── ClickHouse (ROADMAP.md 2.4) ─────────────────────────────────────────
# Analytics-only — trend scoring is the sole reader/writer (apps/workers).
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=x
CLICKHOUSE_PASSWORD=x
CLICKHOUSE_DATABASE=x_analytics

# ── Búsqueda (ROADMAP.md 2.3) ───────────────────────────────────────────
# apps/api queries it; apps/workers' search-indexer keeps it in sync via CDC.
OPENSEARCH_URL=http://localhost:9200

# ── Kafka / Redpanda (ROADMAP.md 2.3 CDC, 3.1) ──────────────────────────
# Comma-separated broker list. apps/api only produces (post.created,
# interaction.events); apps/workers both produces (DLQs) and consumes
# (those two topics, plus the CDC topics Debezium emits for search).
KAFKA_BROKERS=localhost:9092

# ── Autenticación ────────────────────────────────────────────────────────
# ES256 keypair for access tokens (JWT). Leave unset in development: the API
# generates an ephemeral keypair on boot and logs a warning. Required in
# staging/production — the process refuses to start without them there.
# Generate with: pnpm --filter @x/api run generate-jwt-keys
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Optional — SPECS.md §11.3 defaults (10/15min, 5/hour) apply when unset.
# LOGIN_RATE_LIMIT_MAX=10
# FORGOT_PASSWORD_RATE_LIMIT_MAX=5

# ── Almacenamiento de objetos (S3 / MinIO local) ────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=x-media
S3_ACCESS_KEY_ID=x-minio
S3_SECRET_ACCESS_KEY=x-minio-secret
S3_FORCE_PATH_STYLE=true

# ── Email (Mailpit local) ────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@x.example.com

# ── Web Push (ROADMAP.md 2.9) ───────────────────────────────────────────
# Optional — push is reported as unconfigured when unset, rather than
# refusing to boot. Same pair on apps/api (public half only) and
# apps/workers (both halves) — generate with:
# pnpm --filter @x/workers run generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@x.example.com

# ── FCM / APNs (ROADMAP.md 2.9 — apps/workers only) ─────────────────────
# Prepared ahead of the mobile app itself (Phase 4): both optional and
# independent of each other (and of Web Push above) — unset means that
# platform is reported as unconfigured, never a boot failure. Registration
# happens through apps/api's POST /push/device-tokens, same shape as Web
# Push's own POST /push/subscriptions.
#
# FCM (Android) — the three identifying fields of a Firebase service
# account JSON key (Firebase console → Project settings → Service
# accounts → Generate new private key). All three or none.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# The key's "private_key" field verbatim, including its escaped `\n`
# sequences — apps/workers un-escapes them before handing the key to
# firebase-admin, so paste it exactly as the downloaded JSON has it.
FCM_PRIVATE_KEY=

# APNs (iOS) — token-based (P8 key) auth, not the older per-app .p12
# certificate. All four or none.
# APNS_KEY: the .p8 file's own PEM contents (same `\n`-escaping note as
# FCM_PRIVATE_KEY above), not a filesystem path.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# false = APNs sandbox (development-signed app builds), true = production.
APNS_PRODUCTION=false

# ── Moderación (ROADMAP.md 3.3) ─────────────────────────────────────────
# SPECS.md §12.1's preventive layer, "listas de bloqueo" — comma-separated
# terms, case-insensitive substring match. Empty by default everywhere,
# including here: there's no real wordlist to ship in source control, a
# deployment configures its own.
# BLOCKED_TERMS=

# SPECS.md §12.3's new-account limit, "10 posts/día" — same optional/raise-
# don't-disable posture as LOGIN_RATE_LIMIT_MAX above (env.ts's own comment
# on this variable explains the one test file that needs it raised).
# NEW_ACCOUNT_MAX_POSTS_PER_DAY=10
