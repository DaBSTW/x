{
  "name": "@x/workers",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import tsx/esm dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --coverage --config vitest.integration.config.ts",
    "reconcile-counters": "tsx scripts/reconcile-counters.ts"
  },
  "dependencies": {
    "@x/config": "workspace:*",
    "@x/db": "workspace:*",
    "@x/utils": "workspace:*",
    "bullmq": "^5.34.2",
    "drizzle-orm": "^0.38.3",
    "ioredis": "^5.4.2",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@testcontainers/redis": "^10.16.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "testcontainers": "^10.16.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
