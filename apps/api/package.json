    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^2.1.8",
    "testcontainers": "^10.16.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
