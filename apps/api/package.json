    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.4.0",
    "@scalar/fastify-api-reference": "^1.25.85",
    "@x/config": "workspace:*",
    "@x/contracts": "workspace:*",
    "@x/db": "workspace:*",
    "@x/utils": "workspace:*",
    "bullmq": "^5.34.2",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
