{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@x/web#typecheck": {
      // Next.js generates .next/types/**/*.ts (route param typing) only
      // during its own build/dev — tsconfig.json includes that glob, so
      // typecheck fails on a clean checkout without this.
      "dependsOn": ["^build", "build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
